# ===== 後端環境變數設定 =====
# 開發期：
# 1. 將此檔案複製到 backend/.env
# 2. 在 backend/ 執行 npm run dev 啟動後端
# 3. PostgreSQL 資料庫在 Docker，這時的 DB_HOST 是使用 localhost
#
# 容器化後：
# backend 的環境變數變成由 docker-compose.yml 設定；
# 容器內連線 PostgreSQL 時，DB_HOST 應設為 postgres。（後續到容器化步驟時，就會比較理解這個部分）

PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=student
DB_PASSWORD=student666
DB_DATABASE=fitness

JWT_SECRET=CP9Blj1swQv2YpJxD-9Yr7Hy5Z1AMIeeV2I2N1IWu5tvHNirbRPQirTSCy86SNM_ugBKJ-_NpgtBGc5VLdo-7Q
JWT_EXPIRES_DAY=30d

# 下面兩個是給「用課堂 TypeORM 寫法」的人：CI 驗收時也會帶這兩個值
# 想練 W8 教的 migration：把 DB_SYNCHRONIZE 改成 false，改用 npm run migration:run 建表
# （CI 仍然會帶 true，所以走哪條路驗收都不受影響）
DB_SYNCHRONIZE=true
DB_ENABLE_SSL=false

# ===== Cloudflare R2 =====

# R2 S3 Credentials
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 Endpoint
R2_ENDPOINT=

# R2 Bucket
R2_BUCKET_NAME=

# 圖片公開網址
R2_PUBLIC_URL=
